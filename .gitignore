# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never committed, except the template without values
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private owner material: members-only data, never committed (public repo)
docs/private/

# secrets and credentials (never commit keys, service accounts, tokens)
*service-account*.json
*-firebase-adminsdk-*.json
*.key
.runtimeconfig.json

# firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*
pubsub-debug.log*
emulator-data/

# cloud functions build output
functions/lib/
functions/node_modules/

# generated service worker bundle
public/firebase-messaging-sw.js

# test output
/playwright-report/
/test-results/
/blob-report/
