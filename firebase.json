{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "hgprofitoptions",
    "public": "hosting",
    "ignore": ["**/.*"],
    "redirects": [
      {
        "source": "/",
        "destination": "https://hgprofitoptions--hgprofitoptions-hybertec.us-central1.hosted.app/",
        "type": 302
      },
      {
        "source": "/:path*",
        "destination": "https://hgprofitoptions--hgprofitoptions-hybertec.us-central1.hosted.app/:path*",
        "type": 302
      }
    ]
  },
  "apphosting": {
    "backendId": "hgprofitoptions",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "functions",
      "tests",
      "docs/private",
      "emulator-data",
      "test-results",
      "playwright-report",
      ".env.local",
      ".env.*.local",
      "*.log",
      "tsconfig.tsbuildinfo"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "src", "*.log", "tsconfig.json", ".secret.local", ".env.local"],
      "predeploy": [
        "pnpm --dir \"$PROJECT_DIR\" build:functions",
        "npm --prefix \"$RESOURCE_DIR\" ci --no-audit --no-fund"
      ]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 7399
    },
    "firestore": {
      "port": 7380,
      "websocketPort": 7350
    },
    "storage": {
      "port": 7499
    },
    "functions": {
      "port": 7101
    },
    "eventarc": {
      "port": 7299
    },
    "hub": {
      "port": 7410
    },
    "logging": {
      "port": 7510
    },
    "ui": {
      "enabled": true,
      "port": 7300
    }
  }
}
