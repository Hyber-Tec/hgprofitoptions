# End-to-end tests: Playwright drives `next start` on port 3100 against the test emulators
# (firebase.test.json) under a demo project id, so nothing can reach a real Firebase project.
# No secrets: every value here is for the emulators only.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-hgprofitoptions.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hgprofitoptions
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-hgprofitoptions.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_AUTH_EMULATOR_PORT=7699
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=7680
NEXT_PUBLIC_STORAGE_EMULATOR_PORT=7698
FIRESTORE_EMULATOR_HOST=127.0.0.1:7680
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:7699
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:7698
GOOGLE_CLOUD_PROJECT=demo-hgprofitoptions
GCLOUD_PROJECT=demo-hgprofitoptions
METADATA_SERVER_DETECTION=none
DELIVER_ALERTS_INLINE=true
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
RESEND_API_KEY=
EMAIL_FROM=
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_ENCRYPTION_KEY=
MARKET_DATA_API_KEY=
