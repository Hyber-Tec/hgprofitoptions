# Copy to .env.local and fill in. Never commit real values.
# Firebase web app config: Firebase console > Project settings > General > Your apps > HG Profit Options.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hgprofitoptions-hybertec.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hgprofitoptions-hybertec
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hgprofitoptions-hybertec.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=785230671466
NEXT_PUBLIC_FIREBASE_APP_ID=1:785230671466:web:22b3aae71d94bcbdae6413
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-RJJP8TQ44T
# Optional Web Push certificate (Firebase console > Cloud Messaging > Web configuration).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development against the Firebase Emulator Suite (pnpm emulators). Ports match firebase.json
# (they avoid the defaults so other projects' emulators can run side by side). Remove these
# lines to run against the live project (needs `gcloud auth application-default login`).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:7380
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:7399
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:7499
GOOGLE_CLOUD_PROJECT=hgprofitoptions-hybertec
GCLOUD_PROJECT=hgprofitoptions-hybertec
# Local only: skip probing for a Google Cloud metadata server (avoids slow timeouts with emulators).
METADATA_SERVER_DETECTION=none

# Optional integrations. Features stay off until these are set.
# Email (Resend): invites, reminders and alert emails. Both are needed; EMAIL_FROM must use a
# domain verified in Resend, for example: HG Profit Options <alerts@your-domain.com>
RESEND_API_KEY=
EMAIL_FROM=
# Brokerage linking (SnapTrade, read-only connections).
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# 32-byte base64 key that encrypts SnapTrade user secrets at rest (openssl rand -base64 32).
SNAPTRADE_ENCRYPTION_KEY=
# Market data provider (Massive, formerly Polygon.io): end-of-day bars, splits, and live quotes for the tools.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.massive.com

# AI for practice quizzes and class summaries (the key from the AI provider's console).
# AI_BASE_URL is only for the stand-in server in development (pnpm ai:fake); leave it empty otherwise.
AI_API_KEY=
AI_BASE_URL=
# Zoom (docs/deploy.md has the setup). Join the weekly class inside the site: a Meeting SDK app's
# Client ID and Client Secret, made in the Zoom account that hosts the class.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
# AI class recaps: the secret token of the app's event subscription ("Recording transcript files have
# completed", sent to https://<site>/api/zoom/webhook). When Zoom sends no download token with an
# event, a Server-to-Server OAuth app (cloud recording read scope) downloads the transcript instead.
ZOOM_WEBHOOK_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Local development only: do the Cloud Functions' triggered work (alert and strike-target
# notifications, AI quiz writing and class summaries) from the web server instead (use when the
# Functions emulator is not running). Never set in production.
DELIVER_ALERTS_INLINE=false
