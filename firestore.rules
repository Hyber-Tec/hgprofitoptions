rules_version = '2';

// Client access rules. The Next.js server and Cloud Functions use the Admin SDK and bypass these
// rules, so every server path does its own checks (src/lib/auth/guards.ts). These rules protect
// everything the browser touches directly: live alerts, notification tokens, read receipts and
// private journal notes.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('role', '') == 'admin';
    }

    // Admins and data editors (who keep the market data and the tools up to date) see the member area.
    function isStaff() {
      return signedIn() && request.auth.token.get('role', '') in ['admin', 'editor'];
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberData() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    // Active membership: status active and request.time inside the access window that the
    // server keeps on the member document (start of the current block until the day after it ends).
    function hasAccess() {
      return isStaff() || (
        signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && memberData().get('status', '') == 'active'
        && memberData().get('access', null) != null
        && memberData().access.from <= request.time
        && request.time < memberData().access.until
      );
    }

    // Advanced traders and admins answer questions in Chat and read every thread.
    function answersQuestions() {
      return isAdmin() || (hasAccess() && memberData().get('level', 'beginner') == 'advanced');
    }

    function canReadThread(thread) {
      return thread.visibility == 'class' || thread.askerUid == request.auth.uid || answersQuestions();
    }

    // ---- Public content ---------------------------------------------------------------------
    match /testimonials/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    match /faqs/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    match /settings/site {
      allow read: if true;
      allow write: if false;
    }

    // ---- Member content (written by the server only) ----------------------------------------
    match /settings/members {
      allow read: if hasAccess();
      allow write: if false;
    }
    match /tickers/{symbol} {
      allow read: if hasAccess();
      allow write: if false;
    }
    match /weeks/{week} {
      allow read: if hasAccess();
      allow write: if false;
    }
    match /targetUpdates/{id} {
      allow read: if hasAccess() && resource.data.status == 'published';
      allow write: if false;
    }
    match /config/{doc} {
      allow read: if hasAccess() && doc in ['targetGroups', 'leveragedEtfs'];
      allow write: if false;
    }
    match /alerts/{id} {
      allow read: if hasAccess() && resource.data.status in ['published', 'closed'];
      allow write: if false;
      match /revisions/{revision} {
        allow read: if hasAccess();
        allow write: if false;
      }
    }
    match /standing/{period} {
      allow read: if hasAccess();
      allow write: if false;
    }
    match /presentations/{id} {
      allow read: if hasAccess() && resource.data.published == true;
      allow write: if false;
    }
    match /resources/{id} {
      allow read: if hasAccess() && resource.data.published == true;
      allow write: if false;
    }

    // ---- Chat (written by the server only) ------------------------------------------------
    // Class threads are open to every member with access; staff-only ones to the asker, advanced traders and admins.
    match /threads/{threadId} {
      allow read: if hasAccess() && canReadThread(resource.data);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if hasAccess()
          && canReadThread(get(/databases/$(database)/documents/threads/$(threadId)).data);
        allow write: if false;
      }
    }

    // ---- Members -------------------------------------------------------------------------------
    match /members/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;

      match /periods/{id} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }

      // Browser notification tokens for this member's devices (written by the server).
      match /fcmTokens/{tokenId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Read receipts for alerts (written by the server when an alert is opened).
      match /alertReads/{alertId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // When the member last saw each chat thread (written by the server).
      match /threadReads/{threadId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Owner only. Admins can never read private notes, and no server code reads them either.
      match /privateNotes/{tradeId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['body', 'updatedAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 20000
          && request.resource.data.updatedAt == request.time;
      }

      match /trades/{id} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
      match /journalDays/{day} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
      match /connections/{id} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
      match /accounts/{accountId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
        match /{sub=**} {
          allow read: if isSelf(uid) || isAdmin();
          allow write: if false;
        }
      }
    }

    // Everything else (invites, sessions, audit log, job runs, brokerage secrets, bars) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
