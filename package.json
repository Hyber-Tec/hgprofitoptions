{
  "name": "hgprofitoptions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local scripts/build-sw.ts && next dev",
    "build": "tsx --env-file-if-exists=.env.local scripts/build-sw.ts && next build",
    "start": "next start",
    "lint": "next typegen && eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p functions",
    "test": "vitest run --project unit --project golden",
    "test:emulators": "firebase emulators:exec --config firebase.test.json --only firestore,storage --project demo-hgprofitoptions \"vitest run --project rules --project integration\"",
    "test:e2e": "firebase emulators:exec --config firebase.test.json --only auth,firestore,storage --project demo-hgprofitoptions \"tsx scripts/e2e.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project hgprofitoptions-hybertec",
    "emulators:functions": "pnpm build:functions && npm --prefix functions ci --no-audit --no-fund && firebase emulators:start --only auth,firestore,storage,functions --project hgprofitoptions-hybertec",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "import:source": "tsx --env-file=.env.local scripts/import-source-files.ts",
    "auth:totp": "tsx --env-file=.env.local scripts/enable-totp.ts",
    "auth:guard": "tsx scripts/enable-signup-guard.ts",
    "icons:swap": "tsx scripts/swap-icons.ts",
    "build:sw": "tsx --env-file-if-exists=.env.local scripts/build-sw.ts",
    "build:functions": "tsx scripts/build-functions.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lightweight-charts": "^5.2.1",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "exceljs": "^4.4.0",
    "firebase-functions": "7.4.0",
    "firebase-tools": "^15.32.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "unpdf": "^1.8.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
